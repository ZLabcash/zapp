    "Receive follows the address on your Flipper; ▶ there makes a new one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع «استلام» العنوان الظاهر على Flipper؛ والضغط على ▶ هناك ينشئ عنوانًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Empfangen“ folgt der Adresse auf deinem Flipper; ▶ dort erzeugt eine neue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibir sigue la dirección de tu Flipper; ▶ allí crea una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevoir suit l'adresse de votre Flipper ; ▶ sur celui-ci en crée une nouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi segue l'indirizzo sul tuo Flipper; ▶ lì ne crea uno nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け取り画面は Flipper のアドレスに追従します。Flipper で ▶ を押すと新しいアドレスになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받기는 Flipper의 주소를 따릅니다. Flipper에서 ▶를 누르면 새 주소가 생성됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receber acompanha o endereço do seu Flipper; ▶ lá cria um novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Получить» следует за адресом на Flipper; ▶ там создает новый."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้ารับจะแสดงตามที่อยู่บน Flipper กด ▶ ที่นั่นเพื่อสร้างที่อยู่ใหม่"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отримати» слідує за адресою на Flipper; ▶ там створює нову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“接收”会同步 Flipper 上的地址；在那里按 ▶ 可生成新地址。"
          }
        }
      }
    },
