          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kindle recusou a conexão. Pareie-o novamente pelo QR code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle отклонил подключение. Выполните сопряжение заново по его QR-коду."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle ปฏิเสธการเชื่อมต่อ จับคู่อีกครั้งจาก QR โค้ดของ Kindle"
          }
        },
        "uk": {
          "stringUnit": {
