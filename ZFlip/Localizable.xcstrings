    "Send with clear checks on the amount and the network fee, a QR scanner and an address book.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل مع تحقق واضح من المبلغ ورسوم الشبكة، وماسح رموز QR ودفتر عناوين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden mit klarer Prüfung von Betrag und Netzwerkgebühr, QR-Scanner und Adressbuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía con comprobaciones claras del importe y la comisión de red, un lector de QR y una agenda de direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez avec des vérifications claires du montant et des frais de réseau, un lecteur de QR code et un carnet d'adresses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia con controlli chiari su importo e commissione di rete, uno scanner QR e una rubrica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額とネットワーク手数料をわかりやすく確認して送金。QR スキャナとアドレス帳付き。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액과 네트워크 수수료를 명확히 확인하며 보내기, QR 스캐너 및 주소록 제공."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie com verificações claras do valor e da taxa de rede, um leitor de QR code e uma agenda de endereços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка с понятной проверкой суммы и комиссии сети, сканер QR и адресная книга."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งพร้อมการตรวจสอบจำนวนและค่าธรรมเนียมเครือข่ายอย่างชัดเจน มีตัวสแกนคิวอาร์และสมุดที่อยู่"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання з чіткою перевіркою суми й комісії мережі, сканер QR та адресна книга."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送前清晰核对金额和网络手续费，并提供二维码扫描和地址簿。"
          }
        }
      }
    },
