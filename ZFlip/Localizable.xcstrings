    "Couldn't reach the network (%@). The wallet will retry on its own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى الشبكة (%@). ستعيد المحفظة المحاولة تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerk nicht erreichbar (%@). Die Wallet versucht es selbst erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar a la red (%@). La billetera lo reintentará sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réseau injoignable (%@). Le wallet réessaiera tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rete non raggiungibile (%@). Il wallet riproverà da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに接続できません（%@）。ウォレットが自動で再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에 연결할 수 없습니다(%@). 지갑이 자동으로 다시 시도합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar a rede (%@). A carteira tentará de novo sozinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть недоступна (%@). Кошелёк повторит попытку сам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเครือข่ายไม่ได้ (%@) กระเป๋าจะลองใหม่เอง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережа недоступна (%@). Гаманець повторить спробу сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接网络（%@）。钱包会自动重试。"
          }
        }
      }
    },
