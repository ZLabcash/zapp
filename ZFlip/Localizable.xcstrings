    "That leaves nothing for the network fee (%@). You can send up to %@%@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتبقى شيء لرسوم الشبكة (%1$@). يمكنك إرسال ما يصل إلى %2$@%3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Netzwerkgebühr (%1$@) bleibt nichts übrig. Du kannst bis zu %2$@%3$@ senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No queda nada para la comisión de red (%1$@). Puedes enviar hasta %2$@%3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste rien pour les frais de réseau (%1$@). Vous pouvez envoyer jusqu'à %2$@%3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non resta nulla per la commissione di rete (%1$@). Puoi inviare fino a %2$@%3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これではネットワーク手数料（%1$@）が残りません。最大 %2$@%3$@ まで送金できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 네트워크 수수료(%1$@)를 낼 금액이 남지 않습니다. 최대 %2$@%3$@까지 보낼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não sobra nada para a taxa de rede (%1$@). Você pode enviar até %2$@%3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На комиссию сети (%1$@) ничего не остается. Можно отправить до %2$@%3$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะไม่เหลือสำหรับค่าธรรมเนียมเครือข่าย (%1$@) คุณส่งได้สูงสุด %2$@%3$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На комісію мережі (%1$@) нічого не лишається. Можна надіслати до %2$@%3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样就不够支付网络手续费（%1$@）了。你最多可发送 %2$@%3$@。"
          }
        }
      }
    },
    "That's more than your spendable balance of %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا أكثر من رصيدك القابل للإنفاق البالغ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist mehr als dein verfügbares Guthaben von %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es más que tu saldo disponible de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est plus que votre solde disponible de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È più del tuo saldo spendibile di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能残高 %@ を超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능 잔액 %@보다 많습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É mais do que seu saldo disponível de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это больше доступного баланса %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มากกว่ายอดเงินที่ใช้จ่ายได้ของคุณ %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це більше за доступний баланс %@."
          }
        },
