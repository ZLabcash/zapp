    "Give it a name to find it among your wallets.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطها اسمًا لتجدها بين محافظك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ihr einen Namen, um sie unter deinen Wallets zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle un nombre para encontrarla entre tus billeteras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez-lui un nom pour le retrouver parmi vos wallets."
