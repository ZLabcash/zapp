    "Never share these words. Anyone who has them can spend this wallet's funds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشارك هذه الكلمات أبدًا. من يملكها يمكنه إنفاق أموال هذه المحفظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile diese Wörter niemals. Wer sie hat, kann das Guthaben dieser Wallet ausgeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca compartas estas palabras. Quien las tenga puede gastar los fondos de esta billetera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne partagez jamais ces mots. Quiconque les possède peut dépenser les fonds de ce wallet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non condividere mai queste parole. Chi le possiede può spendere i fondi di questo wallet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この単語は絶対に共有しないでください。持っている人は誰でもこのウォレットの資金を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어를 절대 공유하지 마세요. 가진 사람은 누구나 이 지갑의 자금을 쓸 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca compartilhe estas palavras. Quem as tiver pode gastar os fundos desta carteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никому не показывайте эти слова. Любой, у кого они есть, может потратить средства кошелька."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าแชร์คำเหล่านี้ ใครมีก็ใช้เงินในกระเป๋านี้ได้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нікому не показуйте ці слова. Будь-хто, хто їх має, може витратити кошти гаманця."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿分享这些词。任何拥有它们的人都能花掉此钱包的资金。"
          }
        }
      }
    },
