    "Open ZFlip on the Flipper and unlock it, close to this phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ZFlip على Flipper وألغِ قفله، بالقرب من هذا الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ZFlip auf dem Flipper und entsperre ihn, in der Nähe dieses Telefons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre ZFlip en el Flipper y desbloquéalo, cerca de este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez ZFlip sur le Flipper et déverrouillez-le, près de ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri ZFlip sul Flipper e sbloccalo, vicino a questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipper で ZFlip を開いてロックを解除し、この iPhone の近くに置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipper에서 ZFlip을 열고 잠금 해제한 후 이 iPhone 가까이에 두십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o ZFlip no Flipper e desbloqueie-o, perto deste celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте ZFlip на Flipper и разблокируйте его рядом с этим телефоном."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด ZFlip บน Flipper และปลดล็อก วางไว้ใกล้โทรศัพท์เครื่องนี้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте ZFlip на Flipper і розблокуйте його поруч із цим телефоном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Flipper 上打开 ZFlip 并解锁，并靠近这部手机。"
          }
        }
      }
    },
    "Open ZFlip on the Flipper and unlock it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ZFlip على Flipper وألغِ قفله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ZFlip auf dem Flipper und entsperre es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre ZFlip en el Flipper y desbloquéalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez ZFlip sur le Flipper et déverrouillez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri ZFlip sul Flipper e sbloccalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipper で ZFlip を開いてロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipper에서 ZFlip을 열고 잠금을 해제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
