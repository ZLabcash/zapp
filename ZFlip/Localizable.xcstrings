    "Building a shielded transaction and its zero-knowledge proof.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إنشاء معاملة محمية وإثبات المعرفة الصفرية الخاص بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschirmte Transaktion und ihr Zero-Knowledge-Beweis werden erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creando una transacción protegida y su prueba de conocimiento cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Création d'une transaction protégée et de sa preuve à divulgation nulle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creazione di una transazione schermata e della sua prova a conoscenza zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シールドトランザクションとそのゼロ知識証明を作成しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실드 거래와 영지식 증명을 생성하는 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criando uma transação protegida e sua prova de conhecimento zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создание экранированной транзакции и ее доказательства с нулевым разглашением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
