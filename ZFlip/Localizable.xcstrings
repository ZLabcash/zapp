    "Received ZEC can be spent after %lld confirmations, one per block (about 75 s).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إنفاق ZEC المستلمة بعد %lld تأكيدات، تأكيد لكل كتلة (نحو 75 ث)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfangene ZEC sind nach %lld Bestätigungen verfügbar, eine pro Block (etwa 75 s)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ZEC recibidos se pueden gastar tras %lld confirmaciones, una por bloque (unos 75 s)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ZEC reçus sont disponibles après %lld confirmations, une par bloc (environ 75 s)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ZEC ricevuti si possono spendere dopo %lld conferme, una per blocco (circa 75 s)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け取った ZEC は %lld 承認後に使えます。1 ブロックごとに 1 承認（約 75 秒）です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 ZEC는 %lld회 확인 후 사용할 수 있으며, 블록마다 1회 확인됩니다(약 75초)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ZEC recebido pode ser gasto após %lld confirmações, uma por bloco (cerca de 75 s)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полученные ZEC можно потратить после %lld подтверждений, по одному за блок (около 75 с)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ZEC ที่ได้รับจะใช้จ่ายได้หลังการยืนยัน %lld ครั้ง บล็อกละหนึ่งครั้ง (ประมาณ 75 วินาที)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримані ZEC можна витратити після %lld підтверджень, по одному за блок (близько 75 с)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到的 ZEC 需 %lld 次确认后才可花费，每个区块一次（约 75 秒）。"
          }
        }
      }
    },
