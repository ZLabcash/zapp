    "Removes the watch-only wallet from this phone. Your funds stay safe: the keys are on your Kindle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل محفظة المراقبة فقط من هذا الهاتف. تبقى أموالك آمنة: المفاتيح على Kindle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die Watch-only-Wallet von diesem Telefon. Dein Geld bleibt sicher: Die Schlüssel sind auf deinem Kindle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la billetera de solo lectura de este teléfono. Tus fondos siguen a salvo: las claves están en tu Kindle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le wallet en lecture seule de ce téléphone. Vos fonds restent en sécurité : les clés sont sur votre Kindle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il wallet di sola visualizzazione da questo telefono. I tuoi fondi restano al sicuro: le chiavi sono sul tuo Kindle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この電話から閲覧専用ウォレットを削除します。資金は安全です：鍵は Kindle にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서 보기 전용 지갑을 제거합니다. 자금은 안전합니다. 키는 Kindle에 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove a carteira somente leitura deste celular. Seus fundos continuam seguros: as chaves estão no seu Kindle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет кошелёк только для просмотра с этого телефона. Средства в безопасности: ключи на Kindle."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบกระเป๋าแบบดูอย่างเดียวออกจากโทรศัพท์เครื่องนี้ เงินของคุณยังปลอดภัย: คีย์อยู่บน Kindle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє гаманець лише для перегляду з цього телефона. Кошти в безпеці: ключі на Kindle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本机移除只读钱包。你的资金依然安全：密钥在 Kindle 上。"
          }
        }
      }
    },
