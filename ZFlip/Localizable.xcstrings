    "Kindle not found on this Wi-Fi. Open KindleWallet on it, on the same network as this phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على Kindle في شبكة Wi-Fi هذه. افتح KindleWallet عليه، على الشبكة نفسها التي يتصل بها هذا الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle in diesem WLAN nicht gefunden. Öffne KindleWallet darauf, im selben Netzwerk wie dieses Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el Kindle en esta Wi-Fi. Abre KindleWallet en él, en la misma red que este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle introuvable sur ce Wi-Fi. Ouvrez KindleWallet dessus, sur le même réseau que ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle non trovato su questa rete Wi-Fi. Apri KindleWallet sul Kindle, sulla stessa rete di questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Wi-Fi で Kindle が見つかりません。この電話と同じネットワークで、Kindle の KindleWallet を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Wi-Fi에서 Kindle을 찾을 수 없습니다. 이 휴대폰과 같은 네트워크에서 Kindle의 KindleWallet을 여십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle não encontrado neste Wi-Fi. Abra o KindleWallet nele, na mesma rede deste celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle не найден в этой сети Wi-Fi. Откройте на нём KindleWallet в той же сети, что и этот телефон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบ Kindle ใน Wi-Fi นี้ เปิด KindleWallet บน Kindle ในเครือข่ายเดียวกับโทรศัพท์เครื่องนี้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle не знайдено в цій мережі Wi-Fi. Відкрийте на ньому KindleWallet у тій самій мережі, що й цей телефон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Wi-Fi 上找不到 Kindle。请在与本机相同的网络中打开 Kindle 上的 KindleWallet。"
          }
        }
      }
