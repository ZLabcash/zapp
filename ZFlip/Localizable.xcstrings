          }
        }
      }
    },
    "The Zcash network can't be reached. It stays saved here: try again when you're back online.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى شبكة Zcash. تبقى محفوظة هنا: حاول مجددًا عند عودة الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zcash-Netzwerk ist nicht erreichbar. Die Zahlung bleibt hier gespeichert: Versuche es erneut, sobald du online bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a la red Zcash. Queda guardado aquí: inténtalo de nuevo cuando vuelvas a estar en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau Zcash est injoignable. Le paiement reste enregistré ici : réessayez une fois de retour en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rete Zcash non è raggiungibile. Resta salvato qui: riprova quando sei di nuovo online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zcash ネットワークに接続できません。ここに保存されています。オンラインに戻ったら再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zcash 네트워크에 연결할 수 없습니다. 여기에 저장되어 있으니 다시 온라인이 되면 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rede Zcash está inacessível. Fica salvo aqui: tente de novo quando estiver online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть Zcash недоступна. Платёж сохранён здесь: попробуйте снова, когда появится сеть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเครือข่าย Zcash ไม่ได้ บันทึกไว้ที่นี่แล้ว ลองใหม่เมื่อกลับมาออนไลน์"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережа Zcash недоступна. Платіж збережено тут: спробуйте знову, коли з’явиться мережа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Zcash 网络。它会保存在这里：恢复联网后再试。"
          }
        }
      }
    },
    "The camera isn't available. Allow it for ZApp in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا غير متاحة. اسمح بها لـ ZApp في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht verfügbar. Erlaube sie für ZApp in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible. Permite su uso para ZApp en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil photo n'est pas disponible. Autorisez-le pour ZApp dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è disponibile. Consentila per ZApp in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを使用できません。設定で ZApp にカメラへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 사용할 수 없습니다. 설정에서 ZApp의 카메라 접근을 허용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não está disponível. Permita o acesso do ZApp em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Разрешите доступ для ZApp в Настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กล้องไม่ได้ อนุญาตให้ ZApp ใช้ในการตั้งค่า"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Дозвольте доступ для ZApp у Параметрах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用相机。请在“设置”中允许 ZApp 访问相机。"
          }
        }
      }
    },
    "The transaction was not submitted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرسل المعاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion wurde nicht übermittelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción no se envió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction n'a pas été envoyée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione non è stata inviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引は送信されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 제출되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação não foi enviada."
          }
        },
        "ru": {
