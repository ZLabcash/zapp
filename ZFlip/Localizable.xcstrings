    "The Kindle refused the connection. Pair it again from its QR code.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض Kindle الاتصال. أقرنه مرة أخرى من رمز QR الخاص به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kindle hat die Verbindung abgelehnt. Kopple ihn erneut über seinen QR-Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Kindle rechazó la conexión. Vuelve a vincularlo con su código QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Kindle a refusé la connexion. Appairez-le à nouveau avec son QR code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Kindle ha rifiutato la connessione. Abbinalo di nuovo dal suo codice QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle が接続を拒否しました。QR コードからもう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
