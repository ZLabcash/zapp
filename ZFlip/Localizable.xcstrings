          }
        }
      }
    },
    "The zkSNARKs you hold live in your zilkroad account. Sign in there, in its own page, to list them here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد zkSNARKs التي تملكها في حسابك على zilkroad. سجّل الدخول هناك، في صفحته الخاصة، لعرضها هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine zkSNARKs liegen in deinem zilkroad-Konto. Melde dich dort auf der eigenen Seite an, um sie hier aufzulisten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los zkSNARKs que tienes están en tu cuenta de zilkroad. Inicia sesión allí, en su propia página, para verlos aquí."
          }
        },
        "fr": {
          "stringUnit": {
