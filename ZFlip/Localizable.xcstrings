    "Your zkSNARKs stay in your zilkroad account. This phone forgets the list and the session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى zkSNARKs في حسابك على zilkroad. ينسى هذا الهاتف القائمة والجلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine zkSNARKs bleiben in deinem zilkroad-Konto. Dieses Telefon vergisst die Liste und die Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus zkSNARKs siguen en tu cuenta de zilkroad. Este teléfono olvida la lista y la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos zkSNARKs restent dans votre compte zilkroad. Ce téléphone oublie la liste et la session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi zkSNARKs restano nel tuo account zilkroad. Questo telefono dimentica l'elenco e la sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "zkSNARKs は zilkroad アカウントに残ります。この電話は一覧とセッションを消去します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "zkSNARKs는 zilkroad 계정에 그대로 남습니다. 이 휴대폰은 목록과 세션을 지웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus zkSNARKs continuam na sua conta zilkroad. Este celular esquece a lista e a sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши zkSNARKs остаются в аккаунте zilkroad. Телефон забудет список и сессию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "zkSNARKs ของคุณยังอยู่ในบัญชี zilkroad โทรศัพท์เครื่องนี้จะลบรายการและเซสชัน"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші zkSNARKs залишаються в акаунті zilkroad. Телефон забуде список і сесію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 zkSNARKs 仍保留在 zilkroad 账户中。本机会忘记列表和会话。"
          }
        }
      }
    },
