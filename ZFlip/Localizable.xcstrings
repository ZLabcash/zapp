    "Enter an amount above zero, like 0.01.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مبلغًا أكبر من الصفر، مثل 0.01."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Betrag über null ein, z. B. 0.01."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un importe mayor que cero, como 0,01."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un montant supérieur à zéro, comme 0,01."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un importo maggiore di zero, ad esempio 0,01."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0 より大きい金額を入力してください（例：0.01）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0보다 큰 금액을 입력하십시오(예: 0.01)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um valor maior que zero, como 0,01."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите сумму больше нуля, например 0.01."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนจำนวนที่มากกว่าศูนย์ เช่น 0.01"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть суму більше нуля, наприклад 0.01."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入大于零的金额，例如 0.01。"
          }
        }
      }
    },
    "Every address reaches this same wallet, and nobody can link them together.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل عنوان يصل إلى هذه المحفظة نفسها، ولا يمكن لأحد الربط بينها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Adresse führt zu derselben Wallet, und niemand kann sie miteinander verknüpfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dirección llega a esta misma billetera, y nadie puede vincularlas entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque adresse mène à ce même wallet, et personne ne peut les relier entre elles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni indirizzo porta a questo stesso wallet, e nessuno può collegarli tra loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアドレスも同じウォレットに届き、誰もそれらを結び付けられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 주소는 같은 지갑으로 이어지며, 누구도 서로 연결할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo endereço chega a esta mesma carteira, e ninguém consegue ligá-los entre si."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все адреса ведут в этот кошелёк, и никто не может связать их между собой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกที่อยู่ไปยังกระเป๋าเดียวกันนี้ และไม่มีใครเชื่อมโยงที่อยู่เหล่านี้เข้าด้วยกันได้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі адреси ведуть до цього гаманця, і ніхто не може пов’язати їх між собою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个地址都通向同一个钱包，且无人能将它们关联起来。"
          }
        }
      }
    },
