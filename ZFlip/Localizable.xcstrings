    "Open KindleWallet on your Kindle and show its pairing QR code. Both devices must be on the same Wi-Fi.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح KindleWallet على Kindle واعرض رمز QR للاقتران. يجب أن يكون الجهازان على شبكة Wi-Fi نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne KindleWallet auf deinem Kindle und zeige den Kopplungs-QR-Code an. Beide Geräte müssen im selben WLAN sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre KindleWallet en tu Kindle y muestra su código QR de vinculación. Ambos dispositivos deben estar en la misma Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez KindleWallet sur votre Kindle et affichez son QR code d'appairage. Les deux appareils doivent être sur le même Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri KindleWallet sul tuo Kindle e mostra il suo codice QR di abbinamento. Entrambi i dispositivi devono essere sulla stessa rete Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle で KindleWallet を開き、ペアリング用 QR コードを表示してください。両方のデバイスを同じ Wi-Fi に接続する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindle에서 KindleWallet을 열고 페어링 QR 코드를 표시하십시오. 두 기기가 같은 Wi-Fi에 있어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o KindleWallet no seu Kindle e mostre o QR code de pareamento. Os dois aparelhos precisam estar no mesmo Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте KindleWallet на Kindle и покажите QR-код для сопряжения. Оба устройства должны быть в одной сети Wi-Fi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด KindleWallet บน Kindle แล้วแสดง QR โค้ดสำหรับจับคู่ ทั้งสองอุปกรณ์ต้องอยู่ใน Wi-Fi เดียวกัน"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте KindleWallet на Kindle і покажіть QR-код для з’єднання. Обидва пристрої мають бути в одній мережі Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Kindle 上打开 KindleWallet 并显示配对二维码。两台设备必须连接同一 Wi-Fi。"
          }
        }
      }
    },
