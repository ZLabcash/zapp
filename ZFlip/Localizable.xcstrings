        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld di %2$lld · spendibile tra circa %3$lld min"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld · 約 %3$lld 分後に利用可能"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld · 약 %3$lld분 후 사용 가능"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld · disponível em cerca de %3$lld min"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld из %2$lld · доступно примерно через %3$lld мин"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld จาก %2$lld · ใช้จ่ายได้ในอีกประมาณ %3$lld นาที"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld з %2$lld · доступно приблизно через %3$lld хв"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld · 约 %3$lld 分钟后可用"
          }
        }
      }
    },
