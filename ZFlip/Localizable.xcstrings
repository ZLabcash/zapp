    "Choice of server and explorer; light, dark or system appearance.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار الخادم والمستكشف؛ مظهر فاتح أو داكن أو حسب النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahl von Server und Explorer; helle, dunkle oder System-Darstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elección de servidor y explorador; apariencia clara, oscura o del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choix du serveur et de l'explorateur ; apparence claire, sombre ou système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelta di server ed explorer; aspetto chiaro, scuro o di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバとエクスプローラを選択。外観はライト、ダーク、システム設定から選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버와 탐색기 선택, 라이트, 다크 또는 시스템 화면 모드."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha de servidor e explorador; aparência clara, escura ou do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор сервера и обозревателя; светлое, темное или системное оформление."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเซิร์ฟเวอร์และเอกซ์พลอเรอร์ ลักษณะสว่าง มืด หรือตามระบบ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір сервера та оглядача; світлий, темний або системний вигляд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选择服务器和区块浏览器；浅色、深色或跟随系统外观。"
          }
        }
      }
    },
