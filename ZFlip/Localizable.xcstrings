          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transações aparecem aqui conforme a carteira sincroniza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакции появятся здесь по мере синхронизации кошелька."
