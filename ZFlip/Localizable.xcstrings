    "Very small amount: the network fee (%@) is more than what you send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مبلغ صغير جدًا: رسوم الشبكة (%@) أكبر مما ترسله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr kleiner Betrag: Die Netzwerkgebühr (%@) ist höher als das, was du sendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe muy pequeño: la comisión de red (%@) es mayor que lo que envías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montant très faible : les frais de réseau (%@) dépassent ce que vous envoyez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importo molto basso: la commissione di rete (%@) supera quanto invii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額が少なすぎます：ネットワーク手数料（%@）が送金額を上回ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액이 너무 적습니다. 네트워크 수수료(%@)가 보내는 금액보다 많습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor muito pequeno: a taxa de rede (%@) é maior do que o que você envia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень маленькая сумма: комиссия сети (%@) больше отправляемой суммы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนน้อยมาก: ค่าธรรมเนียมเครือข่าย (%@) มากกว่าจำนวนที่ส่ง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуже мала сума: комісія мережі (%@) більша за суму, яку ви надсилаєте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额过小：网络手续费（%@）高于发送金额。"
          }
        }
      }
    },
