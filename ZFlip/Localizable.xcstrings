          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมไม่ได้ถูกส่ง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію не було надіслано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易未提交。"
          }
        }
      }
    },
    "The wallet is scanned from that date. Earlier is safer but takes longer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص المحفظة من ذلك التاريخ. الأقدم أكثر أمانًا لكنه يستغرق وقتًا أطول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wallet wird ab diesem Datum gescannt. Früher ist sicherer, dauert aber länger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La billetera se escanea desde esa fecha. Antes es más seguro pero tarda más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le wallet est scanné à partir de cette date. Plus tôt est plus sûr mais plus long."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il wallet viene scansionato da quella data. Prima è più sicuro ma richiede più tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日付からウォレットをスキャンします。早いほど確実ですが時間がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 날짜부터 지갑을 스캔합니다. 이를수록 안전하지만 더 오래 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira é escaneada a partir dessa data. Antes é mais seguro, mas demora mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелёк сканируется с этой даты. Раньше — надёжнее, но дольше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าจะถูกสแกนตั้งแต่วันนั้น ยิ่งเร็วยิ่งปลอดภัยแต่ใช้เวลานานขึ้น"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець сканується з цієї дати. Раніше — надійніше, але довше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从该日期开始扫描钱包。越早越稳妥，但耗时更长。"
          }
        }
      }
    },
    "The wallet isn't open yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحفظة لم تُفتح بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wallet ist noch nicht geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartera aún no está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille n'est pas encore ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il wallet non è ancora aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットはまだ開かれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 아직 열리지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira ainda não está aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелек еще не открыт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าเงินยังไม่ได้เปิด"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець ще не відкрито."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包尚未打开。"
          }
        }
      }
    },
    "The wallet starts at the block where it was created: older blocks can't hold its funds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ المحفظة من الكتلة التي أُنشئت فيها: لا يمكن أن تحتوي الكتل الأقدم على أموالها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wallet beginnt bei dem Block, in dem sie erstellt wurde: Ältere Blöcke können kein Guthaben von ihr enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartera empieza en el bloque en que se creó: los bloques anteriores no pueden contener sus fondos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille commence au bloc où il a été créé : les blocs antérieurs ne peuvent pas contenir ses fonds."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il wallet parte dal blocco in cui è stato creato: i blocchi precedenti non possono contenere i suoi fondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットは作成されたブロックから始まります：それより前のブロックに資金はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑은 생성된 블록부터 시작합니다. 그 이전 블록에는 자금이 있을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira começa no bloco em que foi criada: blocos anteriores não podem conter seus fundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелек начинается с блока, в котором был создан: в более ранних блоках его средств быть не может."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าเงินเริ่มที่บล็อกที่สร้างขึ้น: บล็อกที่เก่ากว่าไม่สามารถมีเงินของกระเป๋านี้ได้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець починається з блоку, у якому його створено: у старіших блоках його коштів бути не може."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包从创建时的区块开始：更早的区块中不可能有它的资金。"
          }
        }
      }
    },
    "These 24 words are your money. Write them on paper, in order, and keep them offline. Anyone who sees them can spend your funds; without them, a lost phone means lost funds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الكلمات الـ 24 هي أموالك. اكتبها على ورق بالترتيب واحفظها بعيدًا عن الإنترنت. من يراها يمكنه إنفاق أموالك؛ وبدونها، ضياع الهاتف يعني ضياع الأموال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese 24 Wörter sind dein Geld. Schreibe sie der Reihe nach auf Papier und bewahre sie offline auf. Wer sie sieht, kann dein Guthaben ausgeben; ohne sie bedeutet ein verlorenes Telefon verlorenes Geld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas 24 palabras son tu dinero. Escríbelas en papel, en orden, y guárdalas sin conexión. Quien las vea puede gastar tus fondos; sin ellas, un teléfono perdido son fondos perdidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces 24 mots sont votre argent. Notez-les sur papier, dans l'ordre, et gardez-les hors ligne. Quiconque les voit peut dépenser vos fonds ; sans eux, un téléphone perdu, ce sont des fonds perdus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste 24 parole sono il tuo denaro. Scrivile su carta, in ordine, e tienile offline. Chi le vede può spendere i tuoi fondi; senza di esse, un telefono perso significa fondi persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この 24 語があなたのお金です。順番どおり紙に書き、オフラインで保管してください。見た人は誰でも資金を使えます。これがなければ、電話を失うと資金も失います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 24단어가 곧 당신의 돈입니다. 순서대로 종이에 적어 오프라인에 보관하세요. 본 사람은 누구나 자금을 쓸 수 있고, 없으면 휴대폰 분실이 곧 자금 분실입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas 24 palavras são o seu dinheiro. Anote-as em papel, em ordem, e guarde-as offline. Quem as vir pode gastar seus fundos; sem elas, telefone perdido é dinheiro perdido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти 24 слова — ваши деньги. Запишите их на бумаге по порядку и храните офлайн. Любой, кто их увидит, может потратить средства; без них потерянный телефон — потерянные деньги."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "24 คำนี้คือเงินของคุณ จดลงกระดาษตามลำดับ และเก็บแบบออฟไลน์ ใครเห็นก็ใช้เงินของคุณได้ หากไม่มีคำเหล่านี้ โทรศัพท์หายก็คือเงินหาย"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці 24 слова — ваші гроші. Запишіть їх на папері по порядку й зберігайте офлайн. Будь-хто, хто їх побачить, може витратити кошти; без них втрачений телефон — втрачені гроші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这 24 个词就是你的钱。请按顺序写在纸上并离线保存。任何看到它们的人都能花掉你的资金；没有它们，手机丢失就意味着资金丢失。"
          }
        }
      }
    },
    "These words aren't a valid recovery phrase. Check each word and their order.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الكلمات ليست عبارة استرداد صالحة. تحقق من كل كلمة وترتيبها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wörter sind keine gültige Wiederherstellungsphrase. Prüfe jedes Wort und die Reihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palabras no son una frase de recuperación válida. Revisa cada palabra y su orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces mots ne forment pas une phrase de récupération valide. Vérifiez chaque mot et leur ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste parole non sono una frase di recupero valida. Controlla ogni parola e il loro ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
