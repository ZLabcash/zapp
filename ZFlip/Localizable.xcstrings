{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ holds a different wallet than this phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمل %@ محفظة مختلفة عن محفظة هذا الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält eine andere Wallet als dieses Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene una cartera distinta a la de este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contient un autre portefeuille que ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contiene un wallet diverso da quello di questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはこの iPhone とは別のウォレットが入っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 iPhone과 다른 지갑이 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem uma carteira diferente da deste celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ другой кошелек, чем на этом телефоне."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีกระเป๋าเงินคนละใบกับโทรศัพท์เครื่องนี้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ інший гаманець, ніж на цьому телефоні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中的钱包与本机不同。"
          }
        }
      }
    },
    "%@ still confirming: spendable after 10 confirmations.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ قيد التأكيد: قابل للإنفاق بعد 10 تأكيدات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird noch bestätigt: verfügbar nach 10 Bestätigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún en confirmación: disponible tras 10 confirmaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en cours de confirmation : disponible après 10 confirmations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in conferma: spendibile dopo 10 conferme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は承認待ちです：10 承認後に利用可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 확인 중: 10회 확인 후 사용 가능합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda confirmando: disponível após 10 confirmações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ еще подтверждается: станет доступно после 10 подтверждений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ กำลังรอการยืนยัน: ใช้จ่ายได้หลังการยืนยัน 10 ครั้ง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ще підтверджується: буде доступно після 10 підтверджень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在确认中：10 次确认后可用。"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld of %lld · spendable in about %lld min": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld من %2$lld · قابل للإنفاق خلال %3$lld د تقريبًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld · verfügbar in etwa %3$lld Min."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld · disponible en unos %3$lld min"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld sur %2$lld · disponible dans environ %3$lld min"
