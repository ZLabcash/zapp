          }
        }
      }
    },
    "Not enough spendable ZEC. Sending %@ also costs a network fee of at least %@, and received funds become spendable after 10 confirmations.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيد ZEC القابل للإنفاق غير كافٍ. إرسال %1$@ يتطلب أيضًا رسوم شبكة لا تقل عن %2$@، وتصبح الأموال المستلمة قابلة للإنفاق بعد 10 تأكيدات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug verfügbare ZEC. Für das Senden von %1$@ fällt außerdem eine Netzwerkgebühr von mindestens %2$@ an, und empfangenes Guthaben ist erst nach 10 Bestätigungen verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficientes ZEC disponibles. Enviar %1$@ también cuesta una comisión de red de al menos %2$@, y los fondos recibidos están disponibles tras 10 confirmaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZEC disponibles insuffisants. Envoyer %1$@ coûte aussi des frais de réseau d'au moins %2$@, et les fonds reçus deviennent disponibles après 10 confirmations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ZEC spendibili insufficienti. Inviare %1$@ costa anche una commissione di rete di almeno %2$@, e i fondi ricevuti diventano spendibili dopo 10 conferme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な ZEC が不足しています。%1$@ の送金には少なくとも %2$@ のネットワーク手数料もかかり、受け取った資金は 10 承認後に利用可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 ZEC가 부족합니다. %1$@를 보내려면 최소 %2$@의 네트워크 수수료도 필요하며, 받은 자금은 10회 확인 후 사용 가능합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ZEC disponível insuficiente. Enviar %1$@ também custa uma taxa de rede de pelo menos %2$@, e os fundos recebidos ficam disponíveis após 10 confirmações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно доступных ZEC. Отправка %1$@ требует еще комиссии сети не менее %2$@, а полученные средства становятся доступны после 10 подтверждений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ZEC ที่ใช้จ่ายได้ไม่พอ การส่ง %1$@ มีค่าธรรมเนียมเครือข่ายอย่างน้อย %2$@ ด้วย และเงินที่ได้รับจะใช้จ่ายได้หลังการยืนยัน 10 ครั้ง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо доступних ZEC. Надсилання %1$@ потребує ще комісії мережі щонайменше %2$@, а отримані кошти стають доступними після 10 підтверджень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用 ZEC 不足。发送 %1$@ 还需支付至少 %2$@ 的网络手续费，且收到的资金需 10 次确认后才可用。"
          }
        }
      }
    },
