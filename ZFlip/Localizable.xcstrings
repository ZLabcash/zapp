    "Shielded balance, hidden until your Flipper is connected; tap it for its value in your currency.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرصيد المحمي، مخفي حتى يتصل Flipper؛ اضغط عليه لعرض قيمته بعملتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschirmtes Guthaben, verborgen bis dein Flipper verbunden ist; tippe darauf für den Wert in deiner Währung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo protegido, oculto hasta que tu Flipper esté conectado; tócalo para ver su valor en tu moneda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solde protégé, masqué tant que votre Flipper n'est pas connecté ; touchez-le pour sa valeur dans votre devise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo schermato, nascosto finché il Flipper non è connesso; toccalo per vederne il valore nella tua valuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シールド残高。Flipper の接続まで非表示です。タップすると通貨換算額を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실드 잔액. Flipper가 연결될 때까지 숨겨집니다. 탭하면 설정한 통화로 환산한 금액을 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo protegido, oculto até seu Flipper estar conectado; toque nele para ver o valor na sua moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экранированный баланс скрыт, пока Flipper не подключен; коснитесь, чтобы увидеть его в вашей валюте."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดเงินแบบปกป้อง ซ่อนไว้จนกว่าจะเชื่อมต่อ Flipper แตะเพื่อดูมูลค่าในสกุลเงินของคุณ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екранований баланс прихований, доки Flipper не під’єднано; торкніться, щоб побачити його у вашій валюті."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽余额，连接 Flipper 前隐藏；轻点可查看以你的货币计算的价值。"
          }
        }
      }
    },
