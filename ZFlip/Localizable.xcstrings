    "No contacts yet. Add one with +, or save an address from Send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد جهات اتصال بعد. أضف واحدة باستخدام +، أو احفظ عنوانًا من «إرسال»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Kontakte. Füge einen mit + hinzu oder speichere eine Adresse unter „Senden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay contactos. Añade uno con + o guarda una dirección desde Enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
