    "If asked, type the code shown on the Flipper.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا طُلب منك، اكتب الرمز الظاهر على Flipper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls gefragt, gib den Code vom Flipper ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se te pide, escribe el código que muestra el Flipper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si on vous le demande, tapez le code affiché sur le Flipper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se richiesto, digita il codice mostrato sul Flipper."
