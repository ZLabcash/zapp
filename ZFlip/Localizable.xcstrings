    "Your signing device shows the amount, the recipient and the fee. Check them on its screen, then approve to sign.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض جهاز التوقيع المبلغ والمستلم والرسوم. تحقق منها على شاشته، ثم وافق للتوقيع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Signiergerät zeigt Betrag, Empfänger und Gebühr. Prüfe sie auf seinem Bildschirm und bestätige dann zum Signieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo de firma muestra el importe, el destinatario y la comisión. Compruébalos en su pantalla y aprueba para firmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appareil de signature affiche le montant, le destinataire et les frais. Vérifiez-les sur son écran, puis approuvez pour signer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo di firma mostra importo, destinatario e commissione. Controllali sul suo schermo, poi approva per firmare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名デバイスに金額、送金先、手数料が表示されます。画面で確認してから承認して署名してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명 기기에 금액, 받는 사람, 수수료가 표시됩니다. 화면에서 확인한 후 승인하여 서명하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dispositivo de assinatura mostra o valor, o destinatário e a taxa. Confira na tela dele e aprove para assinar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство подписи показывает сумму, получателя и комиссию. Проверьте их на его экране, затем подтвердите подпись."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์เซ็นจะแสดงจำนวน ผู้รับ และค่าธรรมเนียม ตรวจสอบบนหน้าจออุปกรณ์ แล้วอนุมัติเพื่อเซ็น"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрій підпису показує суму, отримувача й комісію. Перевірте їх на його екрані, потім підтвердьте підпис."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名设备会显示金额、收款人和手续费。请在其屏幕上核对，然后批准签名。"
          }
        }
      }
    },
    "Your spendable balance (%@) doesn't cover the network fee of %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيدك القابل للإنفاق (%1$@) لا يغطي رسوم الشبكة البالغة %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein verfügbares Guthaben (%1$@) deckt die Netzwerkgebühr von %2$@ nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu saldo disponible (%1$@) no cubre la comisión de red de %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre solde disponible (%1$@) ne couvre pas les frais de réseau de %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo saldo spendibile (%1$@) non copre la commissione di rete di %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能残高（%1$@）では %2$@ のネットワーク手数料を支払えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능 잔액(%1$@)으로는 %2$@의 네트워크 수수료를 충당할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu saldo disponível (%1$@) não cobre a taxa de rede de %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступного баланса (%1$@) не хватает на комиссию сети %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดเงินที่ใช้จ่ายได้ (%1$@) ไม่พอสำหรับค่าธรรมเนียมเครือข่าย %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступного балансу (%1$@) не вистачає на комісію мережі %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的可用余额（%1$@）不足以支付 %2$@ 的网络手续费。"
          }
        }
      }
    },
