          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先はまだありません。+ で追加するか、送金画面からアドレスを保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 연락처가 없습니다. +로 추가하거나 보내기에서 주소를 저장하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum contato ainda. Adicione um com + ou salve um endereço em Enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контактов пока нет. Добавьте через + или сохраните адрес на экране «Отправить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรายชื่อ เพิ่มด้วย + หรือบันทึกที่อยู่จากหน้าส่ง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контактів ще немає. Додайте через + або збережіть адресу на екрані «Надіслати»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有联系人。点按 + 添加，或在“发送”中保存地址。"
          }
        }
      }
    },
    "No network: you can still sign with your device and broadcast later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد شبكة: لا يزال بإمكانك التوقيع بجهازك والبث لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Netzwerk: Du kannst trotzdem mit deinem Gerät signieren und später übertragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión: aún puedes firmar con tu dispositivo y transmitir más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de réseau : vous pouvez quand même signer avec votre appareil et diffuser plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna rete: puoi comunque firmare con il dispositivo e trasmettere più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークなし：デバイスで署名し、後でブロードキャストできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 연결 없음: 기기로 서명하고 나중에 브로드캐스트할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem rede: você ainda pode assinar com seu dispositivo e transmitir depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети: можно подписать платеж на устройстве и отправить в сеть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเครือข่าย: คุณยังเซ็นด้วยอุปกรณ์และเผยแพร่ภายหลังได้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає мережі: ви все одно можете підписати платіж на пристрої й надіслати в мережу пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无网络：你仍可用设备签名，稍后再广播。"
          }
        }
      }
    },
